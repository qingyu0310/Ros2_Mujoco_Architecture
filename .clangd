# 仓库根 clangd 配置
# 让 framework/ 各子层也能用 build/ 的编译数据库
CompileFlags:
  CompilationDatabase: /home/qingyudd01/projects/vscode/mujoco/project/build
  Add:
    - -ferror-limit=0
    - -Wno-unused-variable
    - "-Wno-#pragma-messages"
    - -isystem/usr/include/c++/13
    - -isystem/usr/include/x86_64-linux-gnu/c++/13
    - -isystem/usr/include/c++/13/backward
    - -isystem/usr/lib/gcc/x86_64-linux-gnu/13/include
    - -isystem/usr/local/include
    - -isystem/usr/include/x86_64-linux-gnu
    - -isystem/usr/include

Diagnostics:
  Suppress:
    - drv_unknown_argument
    - unknown_warning_option
    - unused_variable
    - "#pragma_messages"
